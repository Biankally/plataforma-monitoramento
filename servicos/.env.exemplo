# Copie para servicos/.env e troque as senhas. O .env nunca vai para o Git.
# Use so letras e numeros nas senhas (aspas ou $ quebram os scripts do banco).
MYSQL_ROOT_PASSWORD=troque-esta-senha
# Usuario do site no banco (nao e root)
SITE_DB_USUARIO=site
SITE_DB_SENHA=troque-esta-senha-do-site
# Usuario so leitura que a plataforma usa para medir o banco
MONITOR_DB_SENHA=troque-esta-senha-do-monitor
