# Copie para .env e preencha. O .env NUNCA vai para o Git.
MONITOR_TOKEN=troque-por-um-texto-longo-e-aleatorio
MONITOR_API_URL=http://127.0.0.1:5000
MONITOR_DB=dados/metricas.db

# Agente da VM-S (servicos/agente): a plataforma manda este token no cabecalho X-Token
MONITOR_AGENTE_TOKEN=troque-por-outro-texto-longo-e-aleatorio
MONITOR_AGENTE_URL=http://127.0.0.1:9101
# Senha do usuario monitor do MySQL: a MESMA do servicos/.env (a sonda do banco usa)
MONITOR_DB_SENHA=troque-pela-mesma-do-servicos-env

# "arquivo" grava os e-mails em NOTIF_DIR (testes); "smtp" envia de verdade
NOTIFICADOR=arquivo
NOTIF_DIR=notificacoes
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
ALERTA_DESTINO=
